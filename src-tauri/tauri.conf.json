{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LanDrop",
  "version": "1.0.0",
  "identifier": "app.landrop.desktop",
  "build": {
    "frontendDist": "placeholder"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/landrop-server"],
    "resources": {
      "../public": "public",
      "../skill": "skill"
    },
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false
      }
    },
    "shortDescription": "把电脑变成局域网网盘",
    "longDescription": "LanDrop 把本机变成一个局域网文件服务器，手机扫码即可与电脑互传文件，数据不经过任何云端。"
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/SteveLaiTVT/landrop/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlENzA1QTI5NjAxN0Q0NjkKUldScDFCZGdLVnB3bmV1cTJCaEVnR2p0c2g4UGs5ZVNNOTZWbVdYdGJVbFFkZEp2bmxjallTR1QK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
